{
  "expo": {
    "name": "EvoCo Timesheets",
    "slug": "evoco-timesheets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evoco.evocotimesheets",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.evoco.evocotimesheets"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ad75684f-c0ee-487e-a103-611068a741d4"
    },
    "extra": {
      "eas": {
        "projectId": "ad75684f-c0ee-487e-a103-611068a741d4"
      }
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "EvoCo needs camera access to scan site QR codes for check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "EvoCo needs camera access to take site photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EvoCo needs your location to confirm you're on-site."
        }
      ]
    ]
  }
}
